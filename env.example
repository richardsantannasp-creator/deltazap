# Copie para .env e preencha
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5

# Como o servidor fala com o WhatsApp: official (API da Meta) ou qr (sessão por QR code, pasta gateway/)
PROVIDER=official
# Só no modo qr: o MESMO valor aqui e no gateway/ (GATEWAY_SECRET). Use uma senha longa.
GATEWAY_URL=http://127.0.0.1:3001
GATEWAY_SECRET=
# Vários números (só no modo qr): quantos podem ser cadastrados no painel (Envio e conexão > Adicionar número).
# Cada número tem sessão, QR, limite diário e aquecimento próprios. Mais números não deixam o risco de bloqueio menor: veja o README.
LINES_MAX=5
# Fuso da janela de envio e aquecimento do número
TZ_NAME=America/Sao_Paulo
WARMUP_START=20
WARMUP_STEP=10

# Transcrição de áudio (o Claude lê imagem e PDF, mas não aceita áudio)
# none = não transcreve (o agente pede que o lead escreva) | local = Whisper no seu servidor | openai = API Whisper da OpenAI
STT_PROVIDER=none
WHISPER_MODEL=small
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Vídeo recebido: quadros lidos pelo Claude além do áudio transcrito (0 = só o áudio). Precisa do ffmpeg instalado (no Docker já vem).
VIDEO_FRAMES=3

# Onde guardar o banco e os arquivos recebidos (padrão: dentro desta pasta)
# DB_PATH=sdr.db
# UPLOADS_DIR=uploads

# Painel (obrigatório: sem isso a API do painel fica bloqueada)
DASH_TOKEN=troque-por-uma-senha-longa

# WhatsApp Cloud API (deixe vazio para rodar em modo simulado)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
VERIFY_TOKEN=troque-este-token
META_APP_SECRET=
GRAPH_VERSION=v21.0

# Valores iniciais do nicho "Planos de saúde" (depois você edita tudo no painel, aba Agentes)
# Template aprovado na Meta, com 1 variável {{1}} = primeiro nome
OUTBOUND_TEMPLATE=
OUTBOUND_TEMPLATE_LANG=pt_BR
# Texto equivalente ao template, só para registrar no histórico e dar contexto ao Claude
OUTBOUND_TEXT=Olá, {nome}! Aqui é a Ana, assistente virtual da [CORRETORA]. Você pediu informações sobre plano de saúde e eu posso te mostrar opções sob medida. Posso te fazer 3 perguntas rápidas? Se não quiser receber mensagens, responda SAIR.

# ---------- Avisos para a equipe (aba Avisos do painel) ----------
# Link do painel que vai junto nos avisos (ex.: https://sdr.suaempresa.com.br)
PUBLIC_URL=
# E-mail (opcional): destinatários separados por vírgula + servidor SMTP
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
# Slack/Discord/Teams (opcional): URL do webhook de entrada
NOTIFY_WEBHOOK_URL=

# ---------- Custo do Claude (aba Custos; também editável no painel) ----------
# Preços em USD por milhão de tokens: confira na página de preços da Anthropic para o modelo que você usa. Os valores abaixo são apenas um ponto de partida.
PRICE_IN_USD=1.0
PRICE_OUT_USD=5.0
USD_BRL=5.5
# Orçamento mensal em R$ (0 = sem limite) e o que fazer ao estourar: alertar (só avisa) | bloquear (a IA para de responder até o próximo mês)
BUDGET_MONTH_BRL=0
BUDGET_ACTION=alertar

# ---------- Integração com CRM (aba Integrações) ----------
# Cada evento (lead encaminhado, ganho...) é enviado por POST com JSON, assinado em X-SDR-Signature (HMAC-SHA256 do corpo). Serve para n8n, Make, Zapier, RD Station, Pipedrive etc.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Conectores prontos (também configuráveis na aba Integrações, que tem prioridade).
# Pipedrive: seu domínio (ex.: minhaempresa para minhaempresa.pipedrive.com) e o token de API (Preferências pessoais > API).
PIPEDRIVE_DOMAIN=
PIPEDRIVE_TOKEN=
# HubSpot: token de um "Private App" com permissão de contatos, negócios e notas.
HUBSPOT_TOKEN=

# Aviso do operador (faixa no topo do painel, ex.: assinatura vencendo). Quem hospeda o sistema para clientes grava este arquivo (deploy/sdr-admin.py).
# NOTICE_FILE=/data/aviso-operador.json

# ---------- Backup ----------
# Um backup por dia (banco + arquivos recebidos), guardando os N mais recentes. Copie para fora do servidor também.
BACKUP_AUTO=1
BACKUP_KEEP=14
# BACKUP_DIR=backups

# ---------- Hospedagem com Docker (docker-compose.yml) ----------
SDR_DOMAIN=

# ---- Vender pelo WhatsApp (opcional; também dá para configurar na aba Integrações > Pagamentos) ----
# KB_BUDGET_CHARS=6000        # base de conhecimento até este tamanho vai inteira no prompt; acima disso entram só os trechos da conversa
# ASAAS_API_KEY=              # chave do Asaas (tem prioridade sobre a salva na tela)
# ASAAS_SANDBOX=1             # 1 = ambiente de testes do Asaas; 0 = produção
# STRIPE_SECRET_KEY=          # sk_live_... ou sk_test_...
# STRIPE_WEBHOOK_SECRET=      # whsec_... do endpoint do webhook
# PAY_WEBHOOK_TOKEN=          # token que o Asaas envia no webhook (se vazio, o sistema gera um e mostra na tela)

# Alerta de queda do WhatsApp (modo QR): minutos fora do ar antes de avisar por e-mail/webhook
CONN_ALERT_MIN=5

# Google Agenda (opcional; também dá para configurar pelo painel: veja AGENDA-GOOGLE.md)
GOOGLE_SA_FILE=
GOOGLE_CALENDAR_ID=

# Cópia externa do backup no Supabase Storage (opcional; veja SUPABASE.md). Use a chave service_role e um bucket PRIVADO.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=sdr-backups
OFFSITE_KEEP=30

# App no celular (avisos push): e-mail de contato exigido pelos serviços de aviso dos navegadores (opcional)
# PUSH_CONTACT=voce@suaempresa.com
